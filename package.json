{
  "name": "hoodsniper",
  "private": true,
  "version": "0.1.0",
  "description": "Robinhood Chain / Pons V2 operator-play discovery and sniping system",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './services/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @hood/db run migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.19.0"
  }
}
