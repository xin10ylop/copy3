# --- chain ---
CHAIN_ID=4663
NODE_HTTP=http://127.0.0.1:8547
NODE_WS=ws://127.0.0.1:8548
PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com
FEED_URL=wss://feed.mainnet.chain.robinhood.com
FEED_URL_SECONDARY=wss://delayed-feed.mainnet.chain.robinhood.com
SEND_ENDPOINTS=https://rpc.mainnet.chain.robinhood.com,http://127.0.0.1:8547
# --- db ---
DATABASE_URL=postgres://hood:hood@127.0.0.1:5432/hood
# --- executor (ONLY on the executor host, chmod 600) ---
# exit key first, then one key per burst slot (comma separated); each needs a little ETH for gas
EXECUTOR_PRIVATE_KEYS=
SNIPER_CONTRACT=
EXECUTION_MODE=paper
MAX_GAS_PRICE_GWEI=1
# unset = DAILY_LOSS_LIMIT_PCT of the contract balance at the start of the UTC day
#DAILY_LOSS_LIMIT_ETH=0.5
DAILY_LOSS_LIMIT_PCT=15
PAPER_BANKROLL_ETH=0.1
# --- agent ---
ANTHROPIC_API_KEY=
REPORTS_DIR=./reports
# --- telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# --- nitro node (infra) ---
L1_RPC_URL=
L1_BEACON_URL=
