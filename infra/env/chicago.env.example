# HoodSniper - Chicago box. Copy to the repo root as .env, fill in, chmod 600.
# Used by infra/compose.sh (interpolation) and by every container (env_file).
# Inside containers DATABASE_URL / NODE_HTTP / NODE_WS are overridden to the compose hostnames.

# --- chain ---
CHAIN_ID=4663
PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com
FEED_URL=wss://feed.mainnet.chain.robinhood.com
FEED_URL_SECONDARY=wss://delayed-feed.mainnet.chain.robinhood.com
# host-side tools (pnpm scripts run on the host) reach the node / db on localhost:
NODE_HTTP=http://127.0.0.1:8547
NODE_WS=ws://127.0.0.1:8548

# --- nitro node (infra/docker-compose.yml "nitro") ---
# Ethereum mainnet execution RPC + beacon API that serves blob sidecars (QuickNode/Alchemy/dRPC/...).
L1_RPC_URL=
L1_BEACON_URL=
DATA_ROOT=/data
NITRO_IMAGE=offchainlabs/nitro-node:v3.12.2-5f02f3f
NITRO_BIND=127.0.0.1
# Leave empty when the snapshot was restored with infra/node/run-node.sh snapshot (default flow).
NITRO_INIT_URL=
NITRO_INIT_LATEST=

# --- postgres ---
POSTGRES_USER=hood
# hex/alphanumeric only (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hood
DATABASE_URL=postgres://hood:CHANGE_ME@127.0.0.1:5432/hood
# 127.0.0.1 = local only. Set to the WireGuard address (10.66.0.1) when the Ohio executor connects.
PG_BIND=127.0.0.1
PG_SHARED_BUFFERS=16GB
PG_EFFECTIVE_CACHE_SIZE=48GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=2GB

# --- indexer ---
START_BLOCK=
TRACE_INTERNAL=1

# --- agent (Opus 5.5 play finder / scout / backtest) ---
ANTHROPIC_API_KEY=
REPORTS_DIR=/reports
# hard caps per agent run (rounds / USD), see services/agent/src/config.ts (leave commented = defaults)
# AGENT_MAX_ROUNDS=60
# AGENT_MAX_COST_USD=8
# scout loop of the agent service (also the /scout defaults in Telegram)
SCOUT_INTERVAL_MIN=15
SCOUT_SINCE_MIN=60
SCOUT_MIN_PEAK10_PCT=100
SCOUT_MAX_CLUSTERS=2
# nightly job of the agent service (refit presets, auto-disable losers, blacklist losing operators);
# settings.auto_approve (seeded by `pnpm --filter @hood/db seed`) decides which scout proposals skip the Approve button
NIGHTLY_HOUR_UTC=3
REFIT_DAYS=3
# REFIT_MIN_COINS=20
# REFIT_MARGIN_ETH=0.0005
# ROLLING_TRADES=30
# DISABLE_MIN_TRADES=10
# BLACKLIST_MIN_LAUNCHES=5

# --- telegram ---
TELEGRAM_BOT_TOKEN=
# comma-separated numeric Telegram user ids (ask @userinfobot); only these can use the bot
TELEGRAM_ADMIN_IDS=
# chats that receive notifications (default: the admin ids)
TELEGRAM_NOTIFY_CHAT_IDS=
# daily summary at this local hour (0-23) in TELEGRAM_TZ
TELEGRAM_DAILY_SUMMARY_HOUR=8
TELEGRAM_TZ=America/New_York
# /preset refuses buyEth above this; /watch refuses ranges above TELEGRAM_MAX_WATCH_ETH
TELEGRAM_MAX_BUY_ETH=1
TELEGRAM_MAX_WATCH_ETH=100
# Blockscout base URL and the GMGN chain path segment used in links (GMGN slug unverified)
EXPLORER_URL=https://robinhoodchain.blockscout.com
GMGN_CHAIN=robinhood

# --- ops ---
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=
# COMPOSE_PROFILES=monitoring    # or put it in /etc/hood/stack.env for hood-stack.service
