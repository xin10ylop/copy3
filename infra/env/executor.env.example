# HoodSniper - executor (sniper hot path). Lives ONLY on the executor host as
# /opt/hood/hoodsniper/.env.executor, owner hood, mode 0600. Never commit, never paste in chats/bots.
# Read by systemd (EnvironmentFile): plain KEY=value lines, no inline comments, no quotes needed.

# --- mode & limits ---
# paper until the RUNBOOK step 7 gate is passed, then live
EXECUTION_MODE=paper
MAX_GAS_PRICE_GWEI=1
# realized loss (UTC day) that stops new entries; settings.daily_loss_limit_eth overrides it at runtime.
# Leave DAILY_LOSS_LIMIT_ETH unset to use DAILY_LOSS_LIMIT_PCT of the contract balance at the start of the day
# (the compounding setup: start at 0.01 ETH with ~0.1 ETH in the contract, preset sizing.mode=bankroll)
#DAILY_LOSS_LIMIT_ETH=0.5
DAILY_LOSS_LIMIT_PCT=15
# paper mode only: starting bankroll for sizing.mode=bankroll (grows with realised paper PnL)
PAPER_BANKROLL_ETH=0.1
# max simultaneously open positions
MAX_CONCURRENT=3

# --- keys / contract ---
# Comma-separated 0x... operator keys (RUNBOOK step 6.2): FIRST = exit key, then one burst key per
# concurrent snipe (>= MAX_CONCURRENT), e.g. EXECUTOR_PRIVATE_KEYS=0xexit,0xburst1,0xburst2,0xburst3
# Every key is a PonsSniper operator (setOperator from the cold owner) and pays its own gas: fund
# EACH key with ~0.01 ETH. The keys never hold buy capital (that sits in the contract) and never own it.
# Live mode refuses a single key (exits would queue behind bursts on one nonce); ALLOW_SINGLE_KEY=1
# overrides that for tests only.
EXECUTOR_PRIVATE_KEYS=
#ALLOW_SINGLE_KEY=0
# PonsSniper address printed by contracts/script/deploy.ts. Keep its balance at a few x buyEth: the
# on-chain maxQuoteIn and rolling spend budget bound what a stolen operator key can buy, the balance
# bounds the rest (refill weekly from the cold owner).
SNIPER_CONTRACT=

# --- chain endpoints (Ohio: the public RPC is ~3 ms from the sequencer) ---
FEED_URL=wss://feed.mainnet.chain.robinhood.com
FEED_URL_SECONDARY=wss://delayed-feed.mainnet.chain.robinhood.com
# first = primary send endpoint; the Chicago node over WireGuard is the fallback
SEND_ENDPOINTS=https://rpc.mainnet.chain.robinhood.com,http://10.66.0.1:8547
NODE_WS=ws://10.66.0.1:8548
NODE_HTTP=http://10.66.0.1:8547
PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com

# --- config sync / results (Chicago Postgres over WireGuard) ---
DATABASE_URL=postgres://hood:CHANGE_ME@10.66.0.1:5432/hood

# --- ops ---
HEALTH_PORT=8080
LOG_LEVEL=info
# used by infra/healthcheck.sh --alert on this host
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# --- added by the third review pass (all optional, defaults shown) ---
# EXIT_KEYS=1                      # first n keys of EXECUTOR_PRIVATE_KEYS serve exits (round-robin), the rest are burst slots
# GATE_REFRESH_MS=60000            # re-read the contract config (maxQuoteIn, spend budget) while the live gate passes
# SETTINGS_RELOAD_MS=10000         # periodic settings/kill-switch reload (also on every LISTEN reconnect)
# PLAYS_RELOAD_MS=60000            # periodic plays/armed reload
# FEED_BLOCKS_RETENTION_DAYS=7     # prune feed_blocks older than this
# SWEEP_LOOKBACK_BLOCKS=864000     # first-run lookback for the orphaned-position sweep (~1 day)
# PAPER_MAX_QUOTE_IN_ETH=0.3       # paper mode models the contract caps
# PAPER_MAX_SPEND_PER_WINDOW_ETH=1.2
# PAPER_SPEND_WINDOW_SEC=3600
