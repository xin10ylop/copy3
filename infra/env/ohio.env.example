# HoodSniper - Path A: the paper stack on ONE Ohio box (infra/ohio/compose.yml).
# Lives ONLY on that box as /opt/hood/hoodsniper/.env.ohio (owner hood, mode 0600). bootstrap.sh
# creates it from this template on the first run and never overwrites it. Never commit it (the repo
# .gitignore already ignores .env.*), never paste it into chats or bots.
#
# Format: plain KEY=value lines, no quotes, no inline comments. It is read by `docker compose
# --env-file` for interpolation only: containers receive just the variables compose.yml lists for
# them. An empty value means "use the default shown in the comment".

# ===================================================================== required (bootstrap stops)
# Alchemy API key for Robinhood Chain (dashboard -> app -> API key). ONLY the key, not the URL.
# compose builds https://robinhood-mainnet.g.alchemy.com/v2/<key> and wss://.../v2/<key> from it.
# This file is the only place the key exists. Use a Pay-As-You-Go app (the free tier's 300 CU/s
# and 30M CU/month do not cover ~10 blocks/s; see infra/ohio/README.md "Alchemy cost").
ALCHEMY_KEY=
# Anthropic API key for the agent (scout + nightly refit, claude-opus-5-5). Set a monthly spend
# limit in the Console; each agent run is also capped by AGENT_MAX_COST_USD below.
ANTHROPIC_API_KEY=

# ===================================================================== generated by bootstrap
# Postgres password of user "hood" (db "hood"). bootstrap.sh fills it with `openssl rand -hex 24`
# when empty. Hex/alphanumeric only: it is embedded in DATABASE_URL. Do not change it after the
# first start (the volume keeps the old one).
POSTGRES_PASSWORD=

# ===================================================================== chain endpoints
# Alchemy host for Robinhood Chain mainnet (default robinhood-mainnet.g.alchemy.com).
ALCHEMY_HOST=robinhood-mainnet.g.alchemy.com
# Public sequencer RPC: the sniper's first SEND_ENDPOINT (RTT measurement / burst timing) and its
# fallback read endpoint. SEND_ENDPOINTS = PUBLIC_RPC,<alchemy https url> (built by compose).
PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com
# Sequencer feed = the sniper's detection source (public; the server requires permessage-deflate).
FEED_URL=wss://feed.mainnet.chain.robinhood.com
# comma list of fallback feeds, tried in order after FEED_URL fails
FEED_URL_SECONDARY=wss://delayed-feed.mainnet.chain.robinhood.com

# ===================================================================== indexer
# logs (default) or blocks. Trade-off:
#   logs   = eth_getLogs over the new blocks about once a second, plus one block per block with Pons
#            events: launches, curve trades, token transfers, metrics. About 2-3 RPC calls/s
#            (~200k/day) instead of ~20/s (~1.7M/day). It does NOT index ETH transfers, wallets or
#            internal traces: the tracker arms no candidates (armedWallet plays stay idle) and the
#            agent's funding-trail tools find nothing for new coins. The generic sniping play and
#            every launch/trade/metrics query are unaffected.
#   blocks = every block + receipts (+ traces with INDEXER_TRACE_INTERNAL=1): the full funding graph.
# Switching keeps the checkpoint, so either mode resumes where the other stopped (blocks missed
# by logs mode never get ETH transfers; run `hoodctl backfill` with BACKFILL_BLOCKS_DAYS for that).
INDEXER_MODE=logs
# Websocket for newHeads + Pons logs. Leave the line commented out to use Alchemy WS (default).
# Set it EMPTY (INDEXER_NODE_WS=) to poll the head once a second instead: same data,
# ~1 s later, and it removes the newHeads subscription, the largest item on the Alchemy bill.
#INDEXER_NODE_WS=
# 0 = keep the WS logs subscription (getLogs cross-check, reorg signal) but drop newHeads and poll
# the head once a second (+1 call/s, far fewer compute units than ~10 headers/s over WS). Default 0 on Ohio.
INDEXER_WS_NEW_HEADS=0
# logs mode: at most one getLogs range per this many ms (default 1000; higher = fewer calls, later rows)
INDEXER_LOGS_INTERVAL_MS=
# logs mode: ERC-20 Transfers are fetched for tokens launched within this many hours (default 6).
# Every 100 tokens launched in that window (rounded up) cost one more eth_getLogs per range: at the
# observed ~17 launches/h, 6 h is 1-2 calls/s, 24 h would be ~4-5. Transfers of older tokens (late
# dumps) are not recorded in logs mode.
INDEXER_LOGS_TOKEN_WINDOW_HOURS=
# first block when there is no checkpoint yet (empty = the current head; the backfill covers history)
START_BLOCK=
# process only up to head - CONFIRMATIONS (default 0)
CONFIRMATIONS=0
# blocks rolled back on a parent-hash mismatch / removed log (default 10)
REORG_DEPTH=10
# spacing between the live indexer's RPC calls in ms (default 0: it must keep up with ~10 blocks/s)
INDEXER_RPC_MIN_INTERVAL_MS=0
# blocks mode only (ignored in logs mode): 1 = trace internal ETH transfers of every value-carrying
# tx (funding trails for the tracker/scout). Set 0 while the backfill runs or if the indexer lags
# (hoodctl health): the generic sniping play does not need traces; turn it back to 1 afterwards.
INDEXER_TRACE_INTERNAL=1
# /healthz turns 503 when the indexer is this many blocks behind the head (default 600 = ~60 s)
INDEXER_HEALTH_MAX_LAG_BLOCKS=600

# ===================================================================== backfill (one-shot, profile "backfill")
# logs mode (launches, curve trades, token transfers, metrics) over the last N days (default 3; 0 = skip)
BACKFILL_DAYS=3
# blocks mode (ETH transfers, wallets, internal traces = funding trails) over the last N days
# (default 1; 0 = skip). Bound by Alchemy throughput: at the default spacing ~5 blocks/s, i.e.
# ~2 days of wall time per day of chain. The live indexer collects trails from now on anyway.
BACKFILL_BLOCKS_DAYS=1
# spacing between backfill RPC calls in ms (default 100 = ~5 blocks/s, ~2,600 CU/s of throughput,
# leaving the PAYG 10,000 CU/s to the live indexer; lower it only after buying more throughput)
BACKFILL_RPC_MIN_INTERVAL_MS=100

# ===================================================================== tracker (empty = code default)
# contract mode: a contract created by a funder counts for this many blocks (default 36000 ~ 1 h)
CONTRACT_MAX_AGE_BLOCKS=
# expiry / fired / disarm sweep + plays reload, ms (default 60000)
TRACKER_SWEEP_INTERVAL_MS=
# fallback poll of max(eth_transfers.block), ms (default 5000)
TRACKER_POLL_MS=
# first start without checkpoint: also scan this many blocks before the newest transfer (default 0)
INITIAL_LOOKBACK_BLOCKS=
# arm even if the indexer could not read the recipient's nonce at first funding (default 0)
UNKNOWN_NONCE_IS_FRESH=

# ===================================================================== agent (serve = scout + nightly)
# hard caps per agent run: model turns / USD (defaults 60 / 8)
AGENT_MAX_ROUNDS=60
AGENT_MAX_COST_USD=8
# scout loop period and look-back, minutes (defaults 15 / 30)
SCOUT_INTERVAL_MIN=15
SCOUT_SINCE_MIN=30
# runner threshold: peak within 10 s of the first taxed entry, % (default 100)
SCOUT_MIN_PEAK10_PCT=100
# new clusters investigated by the model per pass / minimum runners per cluster (defaults 2 / 2)
SCOUT_MAX_CLUSTERS=2
SCOUT_MIN_CLUSTER_SIZE=2
# comma list of hub addresses (exchange hot wallets ...) that must not link operators
SCOUT_IGNORE=
# hour (UTC) of the nightly refit / auto-disable / blacklist job; -1 = off (default 3)
NIGHTLY_HOUR_UTC=3
# nightly re-backtest look-back in days / minimum simulated snipes / margin ETH per snipe
REFIT_DAYS=3
REFIT_MIN_COINS=20
REFIT_MARGIN_ETH=0.0005
# rolling realised snipes (paper or live) for the auto-disable, and the minimum before it acts
ROLLING_TRADES=30
DISABLE_MIN_TRADES=10
# generic plays: blacklist an operator whose last N matching launches all lost (default 5)
BLACKLIST_MIN_LAUNCHES=5
# host directory for the agent's CSV + markdown reports (mounted at /reports; owned by uid 1000)
HOOD_REPORTS_DIR=/opt/hood/reports

# ===================================================================== sniper (paper or probe in this stack)
# paper = simulated fills, nothing signed. probe = paper + ONE 0-value self-transfer per planned burst
# at its first slot, to measure where a real buy would land (`hoodctl race`; infra/ohio/README.md
# "Measure the race before going live"). live cannot run here (no SNIPER_CONTRACT is passed).
EXECUTION_MODE=paper
# probe mode: gas-only key(s) from `hoodctl keygen 1`, funded with ~0.002 ETH. NEVER a PonsSniper
# operator / live key: this file is not the executor's key store.
EXECUTOR_PRIVATE_KEYS=
# probe mode: the probe key must hold at least this much gas (else probes are skipped + alert)
MIN_GAS_BALANCE_ETH=0.001
# 1 = run the paper sniper; 0 = do not (set 0 once the LIVE sniper runs on the host)
PAPER_SNIPER=1
# paper fill model: last = after every other buy of the +1 s block (pessimistic), first = optimistic
PAPER_FILL=last
# starting paper bankroll for sizing.mode=bankroll (grows with realised paper PnL)
PAPER_BANKROLL_ETH=0.1
# the contract caps paper mode models: maxQuoteIn, spend budget per window (empty = 4 x maxQuoteIn), window s
PAPER_MAX_QUOTE_IN_ETH=0.3
PAPER_MAX_SPEND_PER_WINDOW_ETH=
PAPER_SPEND_WINDOW_SEC=3600
# pending + open snipes at once (default 3)
MAX_CONCURRENT=3
# blocks snipes while the L2 gas price is above this (default 1)
MAX_GAS_PRICE_GWEI=1
# daily loss limit: fixed ETH, or (when empty) this % of the day's starting bankroll
DAILY_LOSS_LIMIT_ETH=
DAILY_LOSS_LIMIT_PCT=15
# feed_blocks rows older than this are pruned hourly (default 7; 0 = keep)
FEED_BLOCKS_RETENTION_DAYS=7

# ===================================================================== postgres sizing
# ~1/8 and ~1/3 of RAM. 4 GB box: 512MB / 1536MB (defaults). 16 GB box: 2GB / 8GB.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
# container memory cap (default 1536m; raise with PG_SHARED_BUFFERS)
PG_MEM_LIMIT=1536m
# host port bound to 127.0.0.1 only (ssh -L 5432:127.0.0.1:5432 to use a local SQL client)
PG_PORT=5432

# ===================================================================== telegram (optional)
# Uncomment to start the bot with the stack (or run `hoodctl telegram` once).
#COMPOSE_PROFILES=telegram
TELEGRAM_BOT_TOKEN=
# comma-separated numeric Telegram user ids (ask @userinfobot); only these can use the bot
TELEGRAM_ADMIN_IDS=
# chats that receive notifications (default: the admin ids)
TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_DAILY_SUMMARY_HOUR=8
TELEGRAM_TZ=America/New_York
TELEGRAM_MAX_BUY_ETH=1
TELEGRAM_MAX_WATCH_ETH=100
EXPLORER_URL=https://robinhoodchain.blockscout.com
GMGN_CHAIN=robinhood

# ===================================================================== build / ops
# 1 = fail the image build on type errors (default); 0 builds faster on a small box
HOOD_BUILD_TYPECHECK=1
HOOD_IMAGE_TAG=local
LOG_LEVEL=info
