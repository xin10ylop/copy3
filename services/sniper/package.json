{
  "name": "@hood/sniper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/main.ts",
    "paper": "EXECUTION_MODE=paper tsx src/main.ts"
  },
  "dependencies": {
    "@hood/core": "workspace:*",
    "@hood/db": "workspace:*",
    "viem": "^2.45.0",
    "zod": "^4.1.12",
    "pino": "^9.14.0",
    "ws": "^8.18.3",
    "@hood/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@electric-sql/pglite": "^0.3.14"
  }
}
