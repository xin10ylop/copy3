{
  "name": "@hood/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/main.ts",
    "play": "tsx src/main.ts play",
    "scout": "tsx src/main.ts scout",
    "backtest": "tsx src/main.ts backtest",
    "serve": "tsx src/main.ts serve"
  },
  "dependencies": {
    "@hood/core": "workspace:*",
    "@hood/db": "workspace:*",
    "viem": "^2.45.0",
    "zod": "^4.1.12",
    "pino": "^9.14.0",
    "@anthropic-ai/sdk": "^0.90.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14"
  }
}
